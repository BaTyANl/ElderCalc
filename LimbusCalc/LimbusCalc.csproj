<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>ElderCalc</AssemblyName>
    <ApplicationIcon>Assets\elderjar.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Та же иконка нужна как ресурс: из неё берётся значок в заголовке окна. -->
    <Resource Include="Assets\elderjar.ico"/>

    <!-- Шрифт вшивается в сборку, ставить его в систему не требуется.
         Берём статические начертания: вариативные оси WPF не поддерживает. -->
    <Resource Include="Assets\Fonts\*.ttf"/>

    <!-- Иконки типов урона и грехов. -->
    <Resource Include="Assets\Icons\*.png"/>
  </ItemGroup>

</Project>
