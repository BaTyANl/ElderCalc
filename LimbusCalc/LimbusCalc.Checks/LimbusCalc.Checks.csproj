<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LimbusCalc.Checks</RootNamespace>
    <AssemblyName>LimbusCalc.Checks</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Слой расчёта подключается исходниками, а не ссылкой на проект приложения:
         так проверки не тянут за собой WPF и собираются даже когда ElderCalc.exe
         запущен и держит свои файлы. Новые файлы расчёта подхватываются сами. -->
    <Compile Include="..\LimbusCalc\Calculation\*.cs" LinkBase="Calculation" />
  </ItemGroup>

</Project>
