<Window x:Class="LimbusCalc.SubtargetParametersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:behaviors="clr-namespace:LimbusCalc.Behaviors"
        xmlns:vm="clr-namespace:LimbusCalc.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SubtargetViewModel}"
        Title="{Binding ParametersTitle}"
        Icon="Assets/Icons/resistances.png"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FontSize="13"
        FontFamily="{StaticResource AppFontFamily}"
        Background="{DynamicResource AppBackgroundBrush}">

    <Border Style="{StaticResource Card}" Margin="14" Width="260">
        <StackPanel>
            <TextBlock Text="{Binding ParametersTitle}" Style="{StaticResource CardTitleText}"/>

            <TextBlock Text="Dyn mod (%)" Style="{StaticResource FieldLabelText}"/>
            <TextBox behaviors:NumericBox.Value="{Binding ModDynPercent}"/>

            <TextBlock Text="Lvl diff" Style="{StaticResource FieldLabelText}"/>
            <TextBox behaviors:NumericBox.IsInteger="True"
                     behaviors:NumericBox.Value="{Binding OffenseDefenseDiff}"/>

            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <CheckBox Style="{StaticResource CritCheckBox}" VerticalAlignment="Center"
                          IsChecked="{Binding HasCrit, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Crit" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock Text="Crit mod (%)" Style="{StaticResource FieldLabelText}"/>
            <TextBox IsEnabled="{Binding HasCrit}"
                     behaviors:NumericBox.Value="{Binding CritPercent}"/>

            <Border Style="{StaticResource RowDivider}" Margin="0,14"/>

            <StackPanel Orientation="Horizontal">
                <CheckBox Style="{StaticResource MoratoriumCheckBox}" VerticalAlignment="Center"
                          IsChecked="{Binding Shared.TimeMoratorium, UpdateSourceTrigger=PropertyChanged}"/>
                <Image Source="Assets/Icons/timeMoratorium.png" Width="22" Height="22"
                       Margin="8,0,0,0" VerticalAlignment="Center"
                       ToolTip="Time Moratorium"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </StackPanel>

            <TextBlock Text="Stacks (1 or 2)" Style="{StaticResource FieldLabelText}"/>
            <TextBox IsEnabled="{Binding Shared.TimeMoratorium}"
                     behaviors:NumericBox.IsInteger="True"
                     behaviors:NumericBox.Value="{Binding Shared.TimeMoratoriumStacks}"/>
        </StackPanel>
    </Border>
</Window>
