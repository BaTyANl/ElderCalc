<Window x:Class="LimbusCalc.DamageByTargetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LimbusCalc.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Damage by target"
        Icon="Assets/Icons/targetAim.png"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FontSize="13"
        FontFamily="{StaticResource AppFontFamily}"
        Background="{DynamicResource AppBackgroundBrush}">

    <!-- Shared size scope: the total column fits its widest entry (with the moratorium that is
         a whole equation), and the header sits exactly above it. -->
    <Border Style="{StaticResource Card}" Margin="14" Grid.IsSharedSizeScope="True">
        <StackPanel>
            <TextBlock Text="Damage by target" Style="{StaticResource CardTitleText}"/>

            <!-- Header: every label is a sort button for its column. -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <!-- Name column: subtargets can be renamed, so it is wider. -->
                <Border Width="150">
                    <!-- No side padding: the label must start exactly where the column content does. -->
                    <Button DataContext="{Binding TitleColumn}"
                            Content="{Binding Header}"
                            Style="{StaticResource TableHeaderButton}"
                            HorizontalAlignment="Left"
                            Padding="0,2"
                            ToolTip="Sort targets by name"
                            Click="Sort_Click"/>
                </Border>
                <ItemsControl ItemsSource="{Binding CoinColumns}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="86">
                                <Button Content="{Binding Header}"
                                        Style="{StaticResource TableHeaderButton}"
                                        ToolTip="Sort targets by this coin damage"
                                        Click="Sort_Click"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Width="20"/>
                <!-- Separates the total from the coins. The negative bottom margin stretches the
                     line down to the rows so it reads as one solid line. -->
                <Border Width="1" Background="{DynamicResource OutlineBrush}"
                        Margin="0,0,0,-6"/>
                <Border Width="19"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition SharedSizeGroup="TotalLeading"/>
                        <ColumnDefinition SharedSizeGroup="TotalEquation"/>
                    </Grid.ColumnDefinitions>
                    <!-- Negative margins let the label extend past a narrow column: with one- or
                         two-digit damage it would otherwise lack room and hug the left edge
                         instead of centering. The label doesn't count toward the column width. -->
                    <Button Grid.ColumnSpan="2"
                            DataContext="{Binding TotalColumn}"
                            Content="{Binding Header}"
                            Style="{StaticResource TableHeaderButton}"
                            HorizontalAlignment="Center"
                            Margin="-200,0"
                            ToolTip="Sort targets by total damage"
                            Click="Sort_Click"/>
                </Grid>
                <!-- Room on the right: the Total label is wider than its column. -->
                <Border Width="24"/>
            </StackPanel>

            <!-- There can be many targets, so the list scrolls. -->
            <ScrollViewer MaxHeight="460" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding DamageByTarget}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <Border Width="150" Padding="0,0,8,0">
                                    <!-- A long name must not stretch the table: trim it and
                                         show the full name in a tooltip. -->
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Title}"/>
                                </Border>

                                <ItemsControl ItemsSource="{Binding CoinDamage}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="86">
                                                <TextBlock Text="{Binding}" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Width="20"/>
                                <Border Width="1" Background="{DynamicResource OutlineBrush}"
                                        Margin="0,-4"/>
                                <Border Width="19"/>

                                <!-- Total per target. With the moratorium it is shown as an equation. -->
                                <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition SharedSizeGroup="TotalLeading"/>
                                    <ColumnDefinition SharedSizeGroup="TotalEquation"/>
                                </Grid.ColumnDefinitions>
                                    <!-- Damage before the moratorium has its own column, so the red
                                         numbers line up however many digits they have. Left-aligned
                                         so the numbers start at the same place. -->
                                    <TextBlock Grid.Column="0" FontWeight="Bold" VerticalAlignment="Center"
                                               HorizontalAlignment="Left" TextAlignment="Left"
                                               Text="{Binding LeadingText}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowPlainAffected}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource MoratoriumTextBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="&#215;" Margin="8,0,0,0" FontWeight="Bold"
                                               Foreground="{DynamicResource TextBrush}"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding ShowEquation, Converter={StaticResource BoolToVisibility}}"/>
                                    <TextBlock Text="{Binding BuffText}" Margin="8,0,0,0" FontWeight="Bold"
                                               Foreground="{DynamicResource MoratoriumTextBrush}"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding ShowEquation, Converter={StaticResource BoolToVisibility}}"/>
                                    <TextBlock Text="=" Margin="8,0,0,0" FontWeight="Bold"
                                               Foreground="{DynamicResource TextBrush}"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding ShowEquation, Converter={StaticResource BoolToVisibility}}"/>
                                    <TextBlock Text="{Binding TotalText}" Margin="8,0,0,0" FontWeight="Bold"
                                               Foreground="{DynamicResource MoratoriumTextBrush}"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding ShowEquation, Converter={StaticResource BoolToVisibility}}"/>
                                </StackPanel>
                                </Grid>
                                <Border Width="24"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>
    </Border>
</Window>
