<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>ElderCalc</AssemblyName>
    <ApplicationIcon>Assets\elderjar.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- The same icon is needed as a resource: the window title bar icon comes from it. -->
    <Resource Include="Assets\elderjar.ico"/>

    <!-- The font is embedded in the assembly, so it doesn't need to be installed.
         Static weights are used: WPF doesn't support variable font axes. -->
    <Resource Include="Assets\Fonts\*.ttf"/>

    <!-- Damage type and sin icons. -->
    <Resource Include="Assets\Icons\*.png"/>
  </ItemGroup>

</Project>
