<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light theme. Keys must match Dark.xaml: the dictionaries are swapped as a whole. -->

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F4F7"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#ECEEF3"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="OutlineBrush" Color="#D7DBE3"/>

    <SolidColorBrush x:Key="TextBrush" Color="#1A1C21"/>
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#6B7280"/>

    <SolidColorBrush x:Key="AccentBrush" Color="#C0392B"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#D24A3B"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#A32E22"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>

    <!-- Crit checkbox has its own color. -->
    <SolidColorBrush x:Key="CritBrush" Color="#2F6FED"/>

    <!-- Time Moratorium checkbox. -->
    <SolidColorBrush x:Key="MoratoriumBrush" Color="#D69E00"/>

    <!-- The total when Time Moratorium is on. Pure yellow is unreadable on a light
         background, so this is amber — the most yellow shade that still reads. -->
    <SolidColorBrush x:Key="MoratoriumTextBrush" Color="#E0A008"/>

    <!-- Scrollbar thumb. -->
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C3C8D2"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#A2AAB9"/>

</ResourceDictionary>
