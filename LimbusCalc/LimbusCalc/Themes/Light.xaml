<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Светлая тема. Ключи должны совпадать с Dark.xaml: словари подменяются целиком. -->

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F4F7"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#ECEEF3"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="OutlineBrush" Color="#D7DBE3"/>

    <SolidColorBrush x:Key="TextBrush" Color="#1A1C21"/>
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#6B7280"/>

    <SolidColorBrush x:Key="AccentBrush" Color="#C0392B"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#D24A3B"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#A32E22"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>

    <!-- Отдельный цвет флажка крита. -->
    <SolidColorBrush x:Key="CritBrush" Color="#2F6FED"/>

</ResourceDictionary>
