<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark theme. Keys must match Light.xaml: the dictionaries are swapped as a whole. -->

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#15171C"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1E2128"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#272B34"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#272B34"/>
    <SolidColorBrush x:Key="OutlineBrush" Color="#363B47"/>

    <SolidColorBrush x:Key="TextBrush" Color="#E9EBEF"/>
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#98A0AD"/>

    <SolidColorBrush x:Key="AccentBrush" Color="#DE5040"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#EA6152"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#C13F31"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>

    <!-- Crit checkbox has its own color. -->
    <SolidColorBrush x:Key="CritBrush" Color="#4C8DFF"/>

    <!-- Time Moratorium checkbox. -->
    <SolidColorBrush x:Key="MoratoriumBrush" Color="#F0B429"/>

    <!-- The total when Time Moratorium is on. -->
    <SolidColorBrush x:Key="MoratoriumTextBrush" Color="#F7C948"/>

    <!-- Damage color scale in tables: the higher the damage, the stronger the fill. -->
    <SolidColorBrush x:Key="HeatBrush" Color="#3FB27F"/>

    <!-- Scrollbar thumb. -->
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#3E4553"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#525B6D"/>

</ResourceDictionary>
