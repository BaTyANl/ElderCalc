<Window x:Class="LimbusCalc.ExportTableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export"
        Icon="Assets/elderjar.ico"
        SizeToContent="Height"
        Width="380"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FontSize="13"
        FontFamily="{StaticResource AppFontFamily}"
        Background="{DynamicResource AppBackgroundBrush}">

    <Border Style="{StaticResource Card}" Margin="14">
        <StackPanel>
            <TextBlock x:Name="HeaderText" Style="{StaticResource CardTitleText}"/>

            <TextBlock Text="Format" Style="{StaticResource FieldLabelText}"/>
            <RadioButton x:Name="JsonFormat" Content="JSON — can be imported back" GroupName="Format"
                         AutomationProperties.AutomationId="FormatJson" IsChecked="True"/>
            <RadioButton x:Name="ExcelFormat" Content="Excel workbook (.xlsx)" GroupName="Format"
                         AutomationProperties.AutomationId="FormatExcel"/>

            <StackPanel Margin="0,14,0,0">
                <TextBlock Text="Rows" Style="{StaticResource FieldLabelText}"/>
                <RadioButton x:Name="AllRows" Content="All rows" GroupName="Rows"
                             AutomationProperties.AutomationId="AllRows" IsChecked="True"/>
                <RadioButton x:Name="ShownRows" GroupName="Rows"
                             AutomationProperties.AutomationId="ShownRows"/>

                <TextBlock Text="Columns" Style="{StaticResource FieldLabelText}" Margin="0,10,0,0"/>
                <RadioButton x:Name="AllColumns" Content="All columns" GroupName="Columns"
                             AutomationProperties.AutomationId="AllColumns" IsChecked="True"/>
                <RadioButton x:Name="ShownColumns" GroupName="Columns"
                             AutomationProperties.AutomationId="ShownColumns"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Export…" MinWidth="110"
                        AutomationProperties.AutomationId="ExportConfirmButton"
                        IsDefault="True" Click="Export_Click"/>
                <Button Content="Cancel" Width="90" Margin="10,0,0,0"
                        Style="{StaticResource SecondaryButton}"
                        AutomationProperties.AutomationId="CancelButton"
                        IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
