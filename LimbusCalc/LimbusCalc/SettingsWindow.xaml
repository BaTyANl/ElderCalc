<Window x:Class="LimbusCalc.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LimbusCalc.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
        Title="Settings"
        Icon="Assets/elderjar.ico"
        SizeToContent="Height"
        Width="900"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FontSize="13"
        FontFamily="{StaticResource AppFontFamily}"
        Background="{DynamicResource AppBackgroundBrush}">

    <Window.Resources>
        <!-- One outline's color: palette, hex color and opacity. It's switched on and off in the
             left column; while off, the color is dimmed. -->
        <DataTemplate x:Key="OutlineSettingsTemplate">
            <StackPanel Margin="0,0,0,14">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Enabled}" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Title}"
                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Border Width="26" Height="18" Margin="10,0,0,0" CornerRadius="4"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource OutlineBrush}"
                            VerticalAlignment="Center">
                        <Border.Background>
                            <SolidColorBrush Color="{Binding Color}"
                                             Opacity="{Binding OpacityPercent, Converter={StaticResource Percent}}"/>
                        </Border.Background>
                    </Border>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Source={x:Static vm:SettingsViewModel.Palette}}"
                              Margin="0,10,0,0" IsEnabled="{Binding Enabled}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="26" Height="26" Margin="0,0,6,0" Padding="0"
                                    Style="{StaticResource SwatchButton}"
                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    Click="Swatch_Click">
                                <Border CornerRadius="4" Margin="3" BorderThickness="1"
                                        BorderBrush="{DynamicResource OutlineBrush}">
                                    <Border.Background>
                                        <SolidColorBrush Color="{Binding Converter={StaticResource HexColor}}"/>
                                    </Border.Background>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                            IsEnabled="{Binding Enabled}">
                    <TextBlock Text="Color" VerticalAlignment="Center" Width="52"
                               Foreground="{DynamicResource SubtleTextBrush}"/>
                    <TextBox Width="92" Text="{Binding Hex, UpdateSourceTrigger=LostFocus}"/>

                    <TextBlock Text="Opacity" VerticalAlignment="Center" Width="60"
                               Margin="16,0,0,0"
                               Foreground="{DynamicResource SubtleTextBrush}"/>
                    <Slider Width="130" VerticalAlignment="Center"
                            Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                            Value="{Binding OpacityPercent}"/>
                    <TextBlock Text="{Binding OpacityPercent, StringFormat={}{0:0}%}"
                               VerticalAlignment="Center" Width="42" TextAlignment="Right"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- One end of the damage scale: palette, hex color and opacity. -->
        <DataTemplate x:Key="ScaleStopTemplate">
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>

                <ItemsControl ItemsSource="{Binding Source={x:Static vm:SettingsViewModel.Palette}}"
                              Margin="0,8,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="26" Height="26" Margin="0,0,6,0" Padding="0"
                                    Style="{StaticResource SwatchButton}"
                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    Click="Swatch_Click">
                                <Border CornerRadius="4" Margin="3" BorderThickness="1"
                                        BorderBrush="{DynamicResource OutlineBrush}">
                                    <Border.Background>
                                        <SolidColorBrush Color="{Binding Converter={StaticResource HexColor}}"/>
                                    </Border.Background>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="Color" VerticalAlignment="Center" Width="52"
                               Foreground="{DynamicResource SubtleTextBrush}"/>
                    <TextBox Width="92" Text="{Binding Hex, UpdateSourceTrigger=LostFocus}"/>

                    <TextBlock Text="Opacity" VerticalAlignment="Center" Width="60"
                               Margin="16,0,0,0"
                               Foreground="{DynamicResource SubtleTextBrush}"/>
                    <Slider Width="110" VerticalAlignment="Center"
                            Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                            Value="{Binding OpacityPercent}"/>
                    <TextBlock Text="{Binding OpacityPercent, StringFormat={}{0:0}%}"
                               VerticalAlignment="Center" Width="42" TextAlignment="Right"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <!-- Two columns: general switches on the left, every color on the right, so it all fits
         on one screen. On a very small screen it scrolls. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Border Style="{StaticResource Card}" Margin="14">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.ColumnSpan="3" Text="Settings" Style="{StaticResource CardTitleText}"/>

            <!-- General switches. -->
            <StackPanel Grid.Row="1" Grid.Column="0">
                <StackPanel Orientation="Horizontal">
                    <CheckBox VerticalAlignment="Center"
                              AutomationProperties.AutomationId="ThemeCheckBox"
                              IsChecked="{Binding IsDark, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Dark theme" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <Border Style="{StaticResource RowDivider}" Margin="0,16"/>

                <StackPanel Orientation="Horizontal">
                    <CheckBox VerticalAlignment="Center"
                              AutomationProperties.AutomationId="SkillIconsCheckBox"
                              IsChecked="{Binding ShowSkillIcons, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Skill type and sin icons in tables" Margin="8,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Without them the damage stands in the middle of the cell."
                           Foreground="{DynamicResource SubtleTextBrush}"
                           TextWrapping="Wrap" Margin="26,4,0,0"/>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <CheckBox VerticalAlignment="Center"
                              AutomationProperties.AutomationId="DamageScaleCheckBox"
                              IsChecked="{Binding ShowDamageScale, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Damage color scale in tables" Margin="8,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Each cell is tinted by its place in the column, from the lowest damage color to the highest. Counts only what the filters show. The colors are on the right."
                           Foreground="{DynamicResource SubtleTextBrush}"
                           TextWrapping="Wrap" Margin="26,4,0,0"/>

                <Border Style="{StaticResource RowDivider}" Margin="0,16"/>

                <TextBlock Text="Cell outlines in the ID table" FontWeight="SemiBold"
                           Margin="0,0,0,4"/>
                <TextBlock Text="Marks where the damage came from. Empty cells stay without a frame. The colors are on the right."
                           Foreground="{DynamicResource SubtleTextBrush}"
                           TextWrapping="Wrap" Margin="0,0,0,10"/>

                <StackPanel Orientation="Horizontal">
                    <CheckBox VerticalAlignment="Center"
                              AutomationProperties.AutomationId="ManualOutlineCheckBox"
                              IsChecked="{Binding Manual.Enabled, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="{Binding Manual.Title}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <CheckBox VerticalAlignment="Center"
                              AutomationProperties.AutomationId="CalculatorOutlineCheckBox"
                              IsChecked="{Binding Calculator.Enabled, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="{Binding Calculator.Title}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <Border Grid.Row="1" Grid.Column="1" Width="1" Margin="24,0"
                    Background="{DynamicResource OutlineBrush}"/>

            <!-- Colors. -->
            <StackPanel Grid.Row="1" Grid.Column="2">
                <!-- The scale's ends; only matter while the scale is on. -->
                <StackPanel IsEnabled="{Binding ShowDamageScale}">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="Damage color scale" FontWeight="SemiBold" Margin="0,0,0,10"/>

                    <ContentPresenter Content="{Binding ScaleLow}"
                                      ContentTemplate="{StaticResource ScaleStopTemplate}"/>
                    <ContentPresenter Content="{Binding ScaleHigh}"
                                      ContentTemplate="{StaticResource ScaleStopTemplate}"/>

                    <!-- Preview over the table background: lowest on the left, highest on the right. -->
                    <Border Height="22" CornerRadius="4" BorderThickness="1"
                            BorderBrush="{DynamicResource OutlineBrush}"
                            Background="{DynamicResource SurfaceBrush}">
                        <Border CornerRadius="3" AutomationProperties.AutomationId="DamageScalePreview">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="{Binding ScaleLow.PreviewColor}"/>
                                    <GradientStop Offset="1" Color="{Binding ScaleHigh.PreviewColor}"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Border>

                    <Button Content="Reset to default" HorizontalAlignment="Left" Margin="0,10,0,0"
                            Style="{StaticResource SmallButton}"
                            AutomationProperties.AutomationId="ResetDamageScaleButton"
                            Click="ResetDamageScale_Click"/>
                </StackPanel>

                <Border Style="{StaticResource RowDivider}" Margin="0,16"/>

                <TextBlock Text="Cell outline colors" FontWeight="SemiBold" Margin="0,0,0,10"/>

                <ContentPresenter Content="{Binding Manual}"
                                  ContentTemplate="{StaticResource OutlineSettingsTemplate}"/>
                <ContentPresenter Content="{Binding Calculator}"
                                  ContentTemplate="{StaticResource OutlineSettingsTemplate}"/>
            </StackPanel>

            <Button Grid.Row="2" Grid.ColumnSpan="3" Content="Close" Width="90"
                    HorizontalAlignment="Right" Margin="0,6,0,0"
                    Style="{StaticResource SecondaryButton}"
                    IsCancel="True"/>
        </Grid>
    </Border>
    </ScrollViewer>
</Window>
