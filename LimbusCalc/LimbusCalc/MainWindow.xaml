<Window x:Class="LimbusCalc.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:LimbusCalc.Converters"
        xmlns:behaviors="clr-namespace:LimbusCalc.Behaviors"
        xmlns:vm="clr-namespace:LimbusCalc.ViewModels"
        xmlns:views="clr-namespace:LimbusCalc.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="ElderCalc"
        Icon="Assets/elderjar.ico"
        Height="730" Width="1060" MinHeight="520" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        FontSize="13"
        FontFamily="{StaticResource AppFontFamily}"
        Background="{DynamicResource AppBackgroundBrush}"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- Damage type or sin menu item: icon and label. -->
        <DataTemplate x:Key="ElementMenuItemTemplate">
            <StackPanel Orientation="Horizontal">
                <Image Source="{Binding IconPath}" Width="18" Height="18" Margin="0,0,8,0"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>

        <!-- Filter item: the "any" option has no icon, and no room is reserved for one. -->
        <DataTemplate x:Key="ElementFilterTemplate">
            <StackPanel Orientation="Horizontal">
                <Image Source="{Binding IconPath}" Width="16" Height="16" Margin="0,0,6,0"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>

        <!-- One damage cell menu for the whole window, created on first use. A menu per cell,
             with a dozen items and images each, used to be what slowed scrolling down. -->
        <ContextMenu x:Key="CellMenu">
            <MenuItem Header="Export to ElderCalc"
                      Visibility="{Binding HasSetup, Converter={StaticResource BoolToVisibility}}"
                      Click="CellToCalculator_Click"/>
            <MenuItem Header="Manual edit"
                      Visibility="{Binding HasSetup, Converter={StaticResource BoolToVisibility}}"
                      ToolTip="Drop the stored setup and edit the number by hand"
                      Click="CellManualEdit_Click"/>

            <MenuItem Header="Skill type"
                      Visibility="{Binding CanEditMarks, Converter={StaticResource BoolToVisibility}}"
                      ItemsSource="{x:Static vm:ElementOptions.DamageTypes}"
                      ItemTemplate="{StaticResource ElementMenuItemTemplate}">
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <EventSetter Event="Click" Handler="SkillType_Click"/>
                    </Style>
                </MenuItem.ItemContainerStyle>
            </MenuItem>
            <MenuItem Header="Skill sin"
                      Visibility="{Binding CanEditMarks, Converter={StaticResource BoolToVisibility}}"
                      ItemsSource="{x:Static vm:ElementOptions.Sins}"
                      ItemTemplate="{StaticResource ElementMenuItemTemplate}">
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <EventSetter Event="Click" Handler="SkillSin_Click"/>
                    </Style>
                </MenuItem.ItemContainerStyle>
            </MenuItem>
            <Separator Visibility="{Binding CanEditMarks, Converter={StaticResource BoolToVisibility}}"/>
            <MenuItem Header="Clear type and sin"
                      Visibility="{Binding CanEditMarks, Converter={StaticResource BoolToVisibility}}"
                      Click="ClearSkillMarks_Click"/>
        </ContextMenu>

        <!-- Row menu. Opens on cells that describe the row itself — rarity, sinner, name:
             damage cells have their own menu, and the two shouldn't be mixed. -->
        <ContextMenu x:Key="RowMenu">
            <MenuItem Header="Duplicate row"
                      AutomationProperties.AutomationId="DuplicateRowItem"
                      Click="DuplicateRow_Click"/>
            <MenuItem Header="Delete row"
                      AutomationProperties.AutomationId="DeleteRowItem"
                      Click="DeleteRow_Click"/>
        </ContextMenu>

        <!-- Cell editors: created on click, one per table. Cells have no text boxes of their
             own — there would be about three hundred on screen, and scrolling stalled on them. -->
        <DataTemplate x:Key="TextEditorTemplate">
            <TextBox Style="{StaticResource TableCellTextBox}"
                     LostFocus="CellEditor_LostFocus"
                     Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
        </DataTemplate>

        <DataTemplate x:Key="IntegerEditorTemplate">
            <TextBox Style="{StaticResource TableCellTextBox}"
                     TextAlignment="{DynamicResource CellDamageAlignment}"
                     Padding="{DynamicResource CellDamagePadding}"
                     behaviors:IntegerText.Enabled="True"
                     IsReadOnly="{Binding HasSetup}"
                     LostFocus="CellEditor_LostFocus"
                     Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
        </DataTemplate>

        <DataTemplate x:Key="PlainNumberEditorTemplate">
            <TextBox Style="{StaticResource TableCellTextBox}"
                     TextAlignment="Center" Padding="6,4"
                     behaviors:IntegerText.Enabled="True"
                     LostFocus="CellEditor_LostFocus"
                     Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
        </DataTemplate>

        <DataTemplate x:Key="OptionsEditorTemplate">
            <ComboBox Style="{StaticResource TableCellComboBox}"
                      ItemsSource="{Binding Column.Options}"
                      LostFocus="CellEditor_LostFocus"
                      SelectedItem="{Binding Value}"/>
        </DataTemplate>

        <!-- The table's save indicator. Usually a quiet label; when a save fails it turns red
             and explains what happened when clicked. -->
        <Style x:Key="SaveStatusButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
            <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}"/>
            <Setter Property="Content" Value="Saved"/>
            <Setter Property="ToolTip" Value="Every change is saved automatically"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="Label" Background="Transparent"
                                   Foreground="{TemplateBinding Foreground}"
                                   Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="Problem">
                                <Setter TargetName="Label" Property="TextDecorations" Value="Underline"/>
                                <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SaveState}" Value="Saving">
                    <Setter Property="Content" Value="Saving…"/>
                    <Setter Property="ToolTip" Value="The latest changes are being written to disk"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SaveState}" Value="Failed">
                    <Setter Property="Content" Value="Not saved"/>
                    <Setter Property="Tag" Value="Problem"/>
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="ToolTip" Value="The table could not be saved. Click for details"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SaveState}" Value="Off">
                    <Setter Property="Content" Value="Saving off"/>
                    <Setter Property="Tag" Value="Problem"/>
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="ToolTip" Value="Changes to this table are not saved. Click for details"/>
                </DataTrigger>
                <!-- While the table loads there's nothing to save and nothing to report. -->
                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                    <Setter Property="Visibility" Value="Hidden"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Reference table: the model defines the columns, so ID and E.G.O. share this markup.
             The button handlers live in this window, which is why the template is here rather
             than in the shared style dictionary. -->
        <DataTemplate x:Key="ReferenceTableTemplate">
            <Border Style="{StaticResource Card}">
                <Grid>
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <!-- File actions on the right, apart from row editing. -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <!-- Whether the file is saved: the table saves itself, and without the
                                 indicator there's no telling whether it did. Clicking matters only when it didn't. -->
                            <Button Style="{StaticResource SaveStatusButton}"
                                    AutomationProperties.AutomationId="SaveStatus"
                                    Click="SaveStatus_Click"/>
                            <Button Content="Import" Style="{StaticResource SmallButton}"
                                    AutomationProperties.AutomationId="ImportButton"
                                    ToolTip="Load rows from an .xlsx or .json file"
                                    Click="ImportTable_Click"/>
                            <Button Content="Export" Margin="8,0,0,0"
                                    Style="{StaticResource SmallButton}"
                                    AutomationProperties.AutomationId="ExportButton"
                                    ToolTip="Save the table as .xlsx or .json"
                                    Click="ExportTable_Click"/>
                            <Button Content="Copy image" Margin="8,0,0,0" MinWidth="86"
                                    Style="{StaticResource SmallButton}"
                                    AutomationProperties.AutomationId="CopyImageButton"
                                    ToolTip="Copy a picture of the table as it is on screen to the clipboard"
                                    Click="CopyImage_Click"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <Button Content="Add row" Style="{StaticResource SmallButton}"
                                    AutomationProperties.AutomationId="AddRowButton"
                                    Click="AddRow_Click"/>
                            <Button Content="Clear table" Margin="8,0,0,0"
                                    Style="{StaticResource SmallButton}"
                                    AutomationProperties.AutomationId="ClearTableButton"
                                    IsEnabled="{Binding HasRows}"
                                    ToolTip="Remove every row from this table"
                                    Click="ClearTable_Click"/>

                            <!-- Undo sits a little apart: it doesn't edit rows, it reverts an edit. -->
                            <Button Content="Undo" Margin="16,0,0,0"
                                    Style="{StaticResource SmallButton}"
                                    AutomationProperties.AutomationId="UndoButton"
                                    IsEnabled="{Binding History.CanUndo}"
                                    ToolTip="{Binding History.UndoHint}"
                                    ToolTipService.ShowOnDisabled="True"
                                    Click="Undo_Click"/>
                            <Button Content="Redo" Margin="8,0,0,0"
                                    Style="{StaticResource SmallButton}"
                                    AutomationProperties.AutomationId="RedoButton"
                                    IsEnabled="{Binding History.CanRedo}"
                                    ToolTip="{Binding History.RedoHint}"
                                    ToolTipService.ShowOnDisabled="True"
                                    Click="Redo_Click"/>
                            <!-- Which columns to show: extra ones can be hidden, their data stays. -->
                            <Button Content="{Binding ColumnsLabel}" Margin="16,0,0,0"
                                    Style="{StaticResource SmallButton}"
                                    AutomationProperties.AutomationId="ColumnsButton"
                                    ToolTip="Choose which columns to show"
                                    Click="Columns_Click"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Filters: type and sin select individual values, sinners select rows. -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10"
                                DataContext="{Binding Filter}">
                        <TextBlock Text="Filter" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SubtleTextBrush}"
                                   Margin="2,0,10,0"/>

                        <Button Style="{StaticResource SmallButton}"
                                AutomationProperties.AutomationId="FilterTypeButton"
                                Tag="{Binding TypeList}"
                                Content="{Binding TypeList.Label}"
                                Click="FilterList_Click"/>
                        <Button Margin="8,0,0,0" Style="{StaticResource SmallButton}"
                                AutomationProperties.AutomationId="FilterSinButton"
                                Tag="{Binding SinList}"
                                Content="{Binding SinList.Label}"
                                Click="FilterList_Click"/>
                        <Button Margin="8,0,0,0" Style="{StaticResource SmallButton}"
                                AutomationProperties.AutomationId="FilterRarityButton"
                                Tag="{Binding RarityList}"
                                Content="{Binding RarityList.Label}"
                                Visibility="{Binding DataContext.HasRarity,
                                             RelativeSource={RelativeSource AncestorType=ContentPresenter},
                                             Converter={StaticResource BoolToVisibility}}"
                                Click="FilterList_Click"/>
                        <Button Margin="8,0,0,0" Style="{StaticResource SmallButton}"
                                AutomationProperties.AutomationId="FilterSinnersButton"
                                Tag="{Binding SinnerList}"
                                Content="{Binding SinnerList.Label}"
                                Visibility="{Binding DataContext.HasSinners,
                                             RelativeSource={RelativeSource AncestorType=ContentPresenter},
                                             Converter={StaticResource BoolToVisibility}}"
                                Click="FilterList_Click"/>
                        <!-- E.G.O. kind: Awakening or Corrosion; ID has no such column. -->
                        <Button Margin="8,0,0,0" Style="{StaticResource SmallButton}"
                                AutomationProperties.AutomationId="FilterEgoTypeButton"
                                Tag="{Binding EgoTypeList}"
                                Content="{Binding EgoTypeList.Label}"
                                Visibility="{Binding DataContext.HasEgoType,
                                             RelativeSource={RelativeSource AncestorType=ContentPresenter},
                                             Converter={StaticResource BoolToVisibility}}"
                                Click="FilterList_Click"/>

                        <!-- Value ranges and favorites select whole rows, like the sinner filter. -->
                        <Button Margin="8,0,0,0" Style="{StaticResource SmallButton}"
                                AutomationProperties.AutomationId="FilterRangeButton"
                                Content="{Binding RangeLabel}"
                                ToolTip="Show only rows whose values fall within a range"
                                Click="FilterRange_Click"/>
                        <ToggleButton Margin="8,0,0,0" Style="{StaticResource SmallToggleButton}"
                                      AutomationProperties.AutomationId="FavoritesOnlyButton"
                                      Content="★ Favorites"
                                      IsChecked="{Binding FavoritesOnly}"
                                      ToolTip="Show only favorite rows"/>

                        <!-- Name search is a filter too, so it sits in the same row, set slightly
                             apart since it's not a checkbox list. -->
                        <TextBlock Text="Search" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SubtleTextBrush}"
                                   Margin="24,0,8,0"/>
                        <TextBox Width="220" VerticalAlignment="Center"
                                 AutomationProperties.AutomationId="SearchBox"
                                 ToolTip="Show only rows whose name contains this (Ctrl+F)"
                                 Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"/>

                        <!-- Reset sits apart from the filters: it doesn't set them, it clears them
                             all at once. With nothing set there's nothing to clear. -->
                        <Button Content="Clear filters" Margin="24,0,0,0"
                                Style="{StaticResource SmallButton}"
                                AutomationProperties.AutomationId="FilterResetButton"
                                ToolTip="Drop every filter on this table"
                                IsEnabled="{Binding IsActive}"
                                Click="FilterReset_Click"/>

                        <!-- How many rows are left after filtering; otherwise it's not obvious some are hidden. -->
                        <TextBlock Margin="16,0,0,0" VerticalAlignment="Center"
                                   AutomationProperties.AutomationId="FilterSummary"
                                   Foreground="{DynamicResource SubtleTextBrush}"
                                   Text="{Binding DataContext.FilterSummary,
                                          RelativeSource={RelativeSource AncestorType=ContentPresenter}}"/>
                    </StackPanel>

                    <TextBlock DockPanel.Dock="Top" Margin="2,0,0,0"
                               Text="No rows yet — press “Add row”."
                               Foreground="{DynamicResource SubtleTextBrush}"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"/>

                    <!-- The header is outside the rows' scroll viewer, so it's always visible.
                         It follows them horizontally: the offset is copied in code. -->
                    <Border DockPanel.Dock="Top"
                            BorderBrush="{DynamicResource OutlineBrush}"
                            BorderThickness="1,1,0,0"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="HeaderScroll" Tag="TableSyncScroll"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled">
                                <Border BorderBrush="{DynamicResource SubtleTextBrush}"
                                        BorderThickness="0,0,0,2"
                                        HorizontalAlignment="Left">
                                    <ItemsControl ItemsSource="{Binding DisplayColumns}">
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <!-- Left click sorts by the column, Shift+click adds it to
                                                     the sort; dragging moves the column and the right edge
                                                     resizes it. Right click on a skill column opens the
                                                     sort priorities. -->
                                                <Border Padding="8,6" Background="Transparent"
                                                        Width="{Binding ActualWidth}"
                                                        BorderBrush="{DynamicResource OutlineBrush}"
                                                        BorderThickness="0,0,1,0"
                                                        SnapsToDevicePixels="True"
                                                        MouseLeftButtonDown="ColumnHeader_MouseDown"
                                                        MouseMove="ColumnHeader_MouseMove"
                                                        MouseLeftButtonUp="ColumnHeader_LeftClick"
                                                        MouseRightButtonUp="ColumnHeader_RightClick"
                                                        ToolTip="{Binding HeaderTip}">
                                                    <!-- A hand only where a click sorts; the star header just moves. -->
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Cursor" Value="Hand"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSortable}" Value="False">
                                                                    <Setter Property="Cursor" Value="Arrow"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                    <!-- A numeric column's title sits above its numbers,
                                                         i.e. centered in the cell. -->
                                                    <StackPanel Orientation="Horizontal">
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="Integer">
                                                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="Computed">
                                                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="Favorite">
                                                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                                   FontSize="15"/>
                                                        <TextBlock Text="{Binding Indicator}" FontWeight="SemiBold"
                                                                   FontSize="15" Margin="5,0,0,0"
                                                                   Foreground="{DynamicResource AccentBrush}"/>
                                                    </StackPanel>
                                                    <!-- Reaches past the padding to the very edge of the header cell. -->
                                                    <Thumb Style="{StaticResource ColumnResizeGrip}" Margin="0,-6,-12,-6"
                                                           DragDelta="ColumnResize_DragDelta"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                        </ScrollViewer>
                    </Border>

                    <!-- Averages row: average damage per skill column. Sits under the table and
                         doesn't move when the rows scroll vertically. -->
                    <Border DockPanel.Dock="Bottom"
                            BorderBrush="{DynamicResource OutlineBrush}"
                            BorderThickness="1,0,0,1"
                            SnapsToDevicePixels="True"
                            Visibility="{Binding HasRows, Converter={StaticResource BoolToVisibility}}">
                        <ScrollViewer x:Name="AverageScroll" Tag="TableSyncScroll"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled">
                            <Border BorderBrush="{DynamicResource SubtleTextBrush}"
                                    BorderThickness="0,2,0,0"
                                    HorizontalAlignment="Left">
                                <ItemsControl ItemsSource="{Binding Averages}">
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Column.IsHidden}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="8,6"
                                                    Width="{Binding Column.ActualWidth}"
                                                    BorderBrush="{DynamicResource OutlineBrush}"
                                                    BorderThickness="0,0,1,0"
                                                    SnapsToDevicePixels="True">
                                                <TextBlock Text="{Binding Text}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource SubtleTextBrush}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                            <Style.Triggers>
                                                                <!-- The average is aligned like the damage above it. -->
                                                                <DataTrigger Binding="{Binding Column.Kind}" Value="Integer">
                                                                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                                                    <Setter Property="TextAlignment" Value="{DynamicResource CellDamageAlignment}"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Column.Kind}" Value="Computed">
                                                                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                                                    <Setter Property="TextAlignment" Value="Center"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                                </DataTrigger>
                                                                <!-- A number that isn't damage (Sin Cost) is centered. -->
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding Column.Kind}" Value="Integer"/>
                                                                        <Condition Binding="{Binding Column.AcceptsSetup}" Value="False"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="TextAlignment" Value="Center"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </ScrollViewer>
                    </Border>

                    <!-- Rows. The list is virtualized: only visible rows are created; otherwise two
                         hundred IDs would mean two and a half thousand cells at once. The scroll
                         viewer lives inside the list, or virtualization doesn't work. -->
                    <Border BorderBrush="{DynamicResource OutlineBrush}"
                            BorderThickness="1,0,0,0"
                            SnapsToDevicePixels="True">
                        <Grid>
                                <ItemsControl ItemsSource="{Binding Rows}"
                                              FocusVisualStyle="{x:Null}"
                                              VirtualizingPanel.IsVirtualizing="True"
                                              VirtualizingPanel.VirtualizationMode="Recycling"
                                              VirtualizingPanel.ScrollUnit="Pixel"
                                              ScrollViewer.CanContentScroll="True">
                                    <ItemsControl.Template>
                                        <ControlTemplate TargetType="ItemsControl">
                                            <!-- The thumb is dragged fast, and redrawing every row
                                                 in between helps nobody: the rows settle once the
                                                 thumb is released. -->
                                            <ScrollViewer x:Name="TableScroll"
                                                          CanContentScroll="True"
                                                          IsDeferredScrollingEnabled="True"
                                                          HorizontalScrollBarVisibility="Auto"
                                                          VerticalScrollBarVisibility="Auto"
                                                          ScrollChanged="TableScroll_ScrollChanged"
                                                          SizeChanged="TableScroll_SizeChanged">
                                                <ItemsPresenter/>
                                            </ScrollViewer>
                                        </ControlTemplate>
                                    </ItemsControl.Template>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel Orientation="Vertical"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Visibility"
                                                    Value="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- The row draws its own cells: one element per row
                                                 instead of a template per cell. -->
                                            <views:TableRowView MouseLeftButtonDown="RowView_MouseLeftButtonDown"
                                                                ContextMenuOpening="RowView_ContextMenuOpening"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                            <!-- Editor layer: the editor appears over the clicked cell and closes
                                 when the rows scroll. -->
                            <Canvas Tag="CellEditorLayer" ClipToBounds="True">
                                <!-- Opaque background: the cell's text is underneath the editor. -->
                                <Border Tag="CellEditorHost" Visibility="Collapsed"
                                        PreviewKeyDown="CellEditor_PreviewKeyDown"
                                        Background="{DynamicResource SurfaceBrush}">
                                    <ContentControl Tag="CellEditorContent"/>
                                </Border>
                            </Canvas>
                        </Grid>
                    </Border>
                </DockPanel>

                <!-- While the table is read from its file a cover hides it: an edit made before
                     reading finishes would be overwritten by what was read. -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        AutomationProperties.AutomationId="TableLoading"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Loading table…" HorizontalAlignment="Center"
                               VerticalAlignment="Center" FontSize="15"
                               Foreground="{DynamicResource SubtleTextBrush}"/>
                </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="16">

        <!-- Settings sit in the row with the tabs: a separate header just for the title isn't
             needed, it's in the window title anyway. The icon is recolored for the theme with an
             opacity mask — the image itself is black and would vanish on a dark background. -->
        <Button x:Name="SettingsButton" Width="34" Height="34" Padding="0"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,2,2,0" Panel.ZIndex="1"
                Style="{StaticResource IconTileButton}"
                AutomationProperties.AutomationId="SettingsButton"
                ToolTip="Settings"
                Click="Settings_Click">
            <Rectangle Width="19" Height="19" Fill="{DynamicResource TextBrush}">
                <Rectangle.OpacityMask>
                    <ImageBrush ImageSource="Assets/Icons/settings.png"/>
                </Rectangle.OpacityMask>
            </Rectangle>
        </Button>

        <TabControl x:Name="Tabs" SelectedIndex="2">

        <!-- Reference tables: different columns, same markup. -->
        <TabItem Header="ID">
            <ContentPresenter Content="{Binding IdTable}"
                              ContentTemplate="{StaticResource ReferenceTableTemplate}"/>
        </TabItem>

        <TabItem Header="E.G.O.">
            <ContentPresenter Content="{Binding EgoTable}"
                              ContentTemplate="{StaticResource ReferenceTableTemplate}"/>
        </TabItem>

        <TabItem Header="ElderCalc">
        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Shared parameters: take the full height, including the total row on the right. -->
        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="Parameters" Style="{StaticResource CardTitleText}"/>

                    <TextBlock Text="Base roll" Style="{StaticResource FieldLabelText}"/>
                    <TextBox behaviors:NumericBox.IsInteger="True"
                             behaviors:NumericBox.Value="{Binding BaseRoll}"/>

                    <TextBlock Text="Passive dyn mod (%)" Style="{StaticResource FieldLabelText}"/>
                    <TextBox behaviors:NumericBox.Value="{Binding PassiveModDynPercent}"/>

                    <TextBlock Text="Skill type" Style="{StaticResource FieldLabelText}"/>
                    <ComboBox ItemsSource="{Binding DamageTypeOptions}"
                              SelectedItem="{Binding SkillType}"/>

                    <TextBlock Text="Skill sin" Style="{StaticResource FieldLabelText}"/>
                    <ComboBox ItemsSource="{Binding SinOptions}"
                              SelectedItem="{Binding SkillSin}"/>

                    <Border Style="{StaticResource RowDivider}" Margin="0,14"/>

                    <!-- Target resistances: types in a row, sins as a 3 + 4 trapezoid. -->
                    <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="10" Padding="6,10">
                        <StackPanel>
                            <TextBlock FontSize="14" FontWeight="SemiBold" TextAlignment="Center"
                                       HorizontalAlignment="Center" Margin="0,0,0,6">
                                <Run Text="Main target"/><LineBreak/><Run Text="Resistances"/>
                            </TextBlock>

                            <ItemsControl ItemsSource="{Binding TypeResistances}"
                                          ItemTemplate="{StaticResource ResistanceCellTemplate}"
                                          HorizontalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <Border Height="1" Margin="10,10" Background="{DynamicResource OutlineBrush}"/>

                            <ItemsControl ItemsSource="{Binding SinResistancesTop}"
                                          ItemTemplate="{StaticResource ResistanceCellTemplate}"
                                          HorizontalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding SinResistancesBottom}"
                                          ItemTemplate="{StaticResource ResistanceCellTemplate}"
                                          HorizontalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Time Moratorium: damage grows per stack and counts as Sloth damage. -->
                    <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="10"
                            Padding="10" Margin="0,10,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox Style="{StaticResource MoratoriumCheckBox}"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding TimeMoratorium, UpdateSourceTrigger=PropertyChanged}"/>
                                <Image Source="Assets/Icons/timeMoratorium.png" Width="22" Height="22"
                                       Margin="8,0,6,0" VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="Time Moratorium" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Text="Stacks (1 or 2)" Style="{StaticResource FieldLabelText}"/>
                            <TextBox IsEnabled="{Binding TimeMoratorium}"
                                     behaviors:NumericBox.IsInteger="True"
                                     behaviors:NumericBox.Value="{Binding TimeMoratoriumStacks}"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Coins: labels on the left, one column per coin. -->
        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}" Margin="14,0,0,0">
            <!-- Shared vertical scrolling: labels and coins must move together.
                 The transparent background is required: without it empty space doesn't
                 catch the mouse, and the wheel works only over the fields themselves. -->
            <ScrollViewer x:Name="CoinsVerticalScroll" Background="Transparent"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <DockPanel Background="Transparent">
                    <!-- Row heights here must match the coin template. The first two spacers
                         stand in for the card title and the "Coin N" row, which live to the
                         right of the divider. -->
                    <StackPanel DockPanel.Dock="Left" Width="180" Margin="0,0,12,0" VerticalAlignment="Top">
                        <Border Height="40"/>
                        <Border Height="26"/>
                        <Border Height="34"><TextBlock Text="Heads" Style="{StaticResource RowLabelText}"/></Border>
                        <Border Height="34"><TextBlock Text="Coin Power" Style="{StaticResource RowLabelText}"/></Border>
                        <Border Height="34"><TextBlock Text="Dyn mod (%)" Style="{StaticResource RowLabelText}"/></Border>
                        <!-- Top border of a subgroup; heights must match the coin template. -->
                        <Border Height="14">
                            <Border Height="1" VerticalAlignment="Center" Background="{DynamicResource OutlineBrush}"/>
                        </Border>
                        <Border Height="30">
                            <TextBlock Text="Static multipliers" Style="{StaticResource GroupCaptionText}"/>
                        </Border>
                        <Border Height="34"><TextBlock Text="Crit" Style="{StaticResource RowLabelText}"/></Border>
                        <Border Height="34"><TextBlock Text="Crit mod (%)" Style="{StaticResource RowLabelText}"/></Border>
                        <Border Height="34"><TextBlock Text="Lvl diff" Style="{StaticResource RowLabelText}"/></Border>
                        <Border Height="34"><TextBlock Text="Clash count" Style="{StaticResource RowLabelText}"/></Border>
                        <!-- Bottom border of a subgroup; the height must match the coin template. -->
                        <Border Height="14">
                            <Border Height="1" VerticalAlignment="Center" Background="{DynamicResource OutlineBrush}"/>
                        </Border>

                        <Border Height="34"><TextBlock Text="Bonus" Style="{StaticResource GroupCaptionText}"/></Border>

                        <!-- Bonus rows: kind and target are set here, values in the coin columns. -->
                        <ItemsControl ItemsSource="{Binding BonusRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Height="34">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="24"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding KindLabel}"
                                                       Style="{StaticResource RowLabelText}"/>
                                            <ComboBox Grid.Column="1" Margin="0,2" MinHeight="28"
                                                      ItemsSource="{Binding TargetOptions}"
                                                      SelectedItem="{Binding Target}"/>
                                            <Button Grid.Column="2" Content="✕" Style="{StaticResource IconButton}"
                                                    ToolTip="Remove this bonus"
                                                    Click="RemoveBonus_Click"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Height="38">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="+ flat" Style="{StaticResource SmallButton}"
                                        Click="AddFlatBonus_Click"/>
                                <Button Content="+ %" Style="{StaticResource SmallButton}"
                                        Margin="6,0,0,0" Click="AddPercentBonus_Click"/>
                            </StackPanel>
                        </Border>

                        <Border Height="14">
                            <Border Height="1" VerticalAlignment="Center" Background="{DynamicResource OutlineBrush}"/>
                        </Border>

                        <Border Height="34"><TextBlock Text="Weight" Style="{StaticResource RowLabelText}"/></Border>
                        <Border Height="36"/>
                        <Border Style="{StaticResource RowDivider}"/>
                        <Border Height="26"><TextBlock Text="Roll" Style="{StaticResource RowLabelText}"/></Border>
                        <Border Height="26"><TextBlock Text="Mod stat" Style="{StaticResource RowLabelText}"/></Border>
                        <Border Height="26"><TextBlock Text="Damage" Style="{StaticResource RowLabelText}"/></Border>
                    </StackPanel>

                    <!-- Vertical divider between the labels and the coin columns. -->
                    <Border DockPanel.Dock="Left" Width="1" Margin="0,0,14,0"
                            Background="{DynamicResource OutlineBrush}"/>

                    <DockPanel>
                        <!-- Height with margin is 40: the same as the empty top row in
                             the label column. -->
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                                    Height="30" Margin="0,0,0,10">
                            <TextBlock Text="Coins" FontSize="15" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <Button Content="Add coin" Padding="10,4" FontSize="12"
                                    Margin="18,0,0,0" VerticalAlignment="Center"
                                    Click="AddCoin_Click"/>
                            <Button Content="Remove last coin" Style="{StaticResource SmallButton}"
                                    Margin="6,0,0,0" VerticalAlignment="Center"
                                    Click="RemoveCoin_Click"/>
                        </StackPanel>

                        <!-- The wheel over the coins goes to the outer scroller; it isn't needed here. -->
                        <ScrollViewer Background="Transparent"
                                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                      PreviewMouseWheel="CoinsScroll_PreviewMouseWheel">
                            <!-- Coin columns are split in two with the shared Clash count row in
                                 between. That way it stretches across the columns by itself. -->
                            <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left">
                            <ItemsControl x:Name="CoinTopRows" ItemsSource="{Binding Coins}"
                                          VerticalAlignment="Top" HorizontalAlignment="Left">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Width="96" Margin="0,0,10,0">
                                            <Border Height="26">
                                                <TextBlock Text="{Binding Number, StringFormat='Coin {0}'}"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <Border Height="34">
                                                <CheckBox IsChecked="{Binding Active, UpdateSourceTrigger=PropertyChanged}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Border Height="34">
                                                <TextBox Margin="0,2" TextAlignment="Center"
                                                         behaviors:NumericBox.IsInteger="True"
                                                         behaviors:NumericBox.Value="{Binding Power}"/>
                                            </Border>
                                            <Border Height="34">
                                                <TextBox Margin="0,2" TextAlignment="Center"
                                                         behaviors:NumericBox.Value="{Binding ModDynPercent}"/>
                                            </Border>

                                            <!-- Top border of a subgroup; its caption is on the left. -->
                                            <Border Height="14">
                                                <Border Height="1" VerticalAlignment="Center"
                                                        Background="{DynamicResource OutlineBrush}"/>
                                            </Border>
                                            <Border Height="30"/>
                                            <Border Height="34">
                                                <CheckBox Style="{StaticResource CritCheckBox}"
                                                          IsChecked="{Binding HasCrit, UpdateSourceTrigger=PropertyChanged}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Border Height="34">
                                                <TextBox Margin="0,2" TextAlignment="Center"
                                                         IsEnabled="{Binding HasCrit}"
                                                         behaviors:NumericBox.Value="{Binding CritPercent}"/>
                                            </Border>
                                            <Border Height="34">
                                                <TextBox Margin="0,2" TextAlignment="Center"
                                                         behaviors:NumericBox.IsInteger="True"
                                                         behaviors:NumericBox.Value="{Binding OffenseDefenseDiff}"/>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Clash count is one per skill. Its width comes from the row of
                                 columns, so the field grows as coins are added. -->
                            <Border Height="34" HorizontalAlignment="Left"
                                    Width="{Binding ActualWidth, ElementName=CoinTopRows}">
                                <TextBox Margin="0,2,10,2" TextAlignment="Center"
                                         AutomationProperties.AutomationId="ClashCountField"
                                         behaviors:NumericBox.IsInteger="True"
                                         behaviors:NumericBox.Value="{Binding ClashCount}"/>
                            </Border>

                            <!-- Left alignment is required: otherwise the columns would stretch
                                 to the width of the shared field, which takes its width from
                                 them — and removing a coin wouldn't shrink the row. -->
                            <ItemsControl ItemsSource="{Binding Coins}" VerticalAlignment="Top"
                                          HorizontalAlignment="Left">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Width="96" Margin="0,0,10,0">
                                            <!-- Bottom border of a subgroup. -->
                                            <Border Height="14">
                                                <Border Height="1" VerticalAlignment="Center"
                                                        Background="{DynamicResource OutlineBrush}"/>
                                            </Border>

                                            <!-- Empty row under the bonus group caption on the left. -->
                                            <Border Height="34"/>

                                            <!-- Bonus values; the same rows as in the label column. -->
                                            <ItemsControl ItemsSource="{Binding Bonuses}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Height="34">
                                                            <TextBox Margin="0,2" TextAlignment="Center"
                                                                     behaviors:NumericBox.Value="{Binding Value}"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Space under the add-bonus buttons on the left. -->
                                            <Border Height="38"/>

                                            <Border Height="14">
                                                <Border Height="1" VerticalAlignment="Center"
                                                        Background="{DynamicResource OutlineBrush}"/>
                                            </Border>

                                            <Border Height="34">
                                                <TextBox Margin="0,2" TextAlignment="Center"
                                                         AutomationProperties.AutomationId="WeightField"
                                                         behaviors:NumericBox.IsInteger="True"
                                                         behaviors:NumericBox.Value="{Binding Weight}"/>
                                            </Border>
                                            <!-- Extra target resistances; none at weight 1. -->
                                            <Border Height="36">
                                                <Button Width="28" Height="28" Padding="0"
                                                        Style="{StaticResource IconTileButton}"
                                                        AutomationProperties.AutomationId="SubtargetsButton"
                                                        IsEnabled="{Binding HasSubtargets}"
                                                        Click="Subtargets_Click">
                                                    <Button.ToolTip>
                                                        <TextBlock>
                                                            <Run Text="Subtargets"/><LineBreak/><Run Text="resistances"/>
                                                        </TextBlock>
                                                    </Button.ToolTip>
                                                    <Image Source="Assets/Icons/lodgedArrow.png"
                                                           Width="18" Height="18"
                                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </Button>
                                            </Border>

                                            <Border Style="{StaticResource RowDivider}"/>

                                            <Border Height="26">
                                                <TextBlock Style="{StaticResource ResultValueText}"
                                                           Text="{Binding Roll, Converter={StaticResource Num}, ConverterParameter=F0, Mode=OneWay}"/>
                                            </Border>
                                            <Border Height="26">
                                                <TextBlock Style="{StaticResource ResultValueText}"
                                                           Text="{Binding ModStat, Converter={StaticResource Num}, ConverterParameter=F3, Mode=OneWay}"/>
                                            </Border>
                                            <Border Height="26">
                                                <!-- 0.## drops a zero fraction: 1.00 shows as 1. -->
                                                <TextBlock Style="{StaticResource ResultValueText}" FontWeight="SemiBold"
                                                           Text="{Binding Damage, Converter={StaticResource Num}, ConverterParameter=0.##, Mode=OneWay}"/>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </DockPanel>
            </ScrollViewer>
        </Border>

        <!-- Total: under the coin columns, not across the whole window. -->
        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Margin="14,14,0,0">
          <DockPanel>
            <!-- Setup file actions on the right of the total row. -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button Content="Export as JSON" Style="{StaticResource SmallButton}"
                        AutomationProperties.AutomationId="ExportSetupButton"
                        ToolTip="Save the whole calculator setup to a file"
                        Click="ExportSetup_Click"/>
                <Button Content="Import JSON" Margin="8,0,0,0"
                        Style="{StaticResource SmallButton}"
                        AutomationProperties.AutomationId="ImportSetupButton"
                        ToolTip="Load a calculator setup from a file"
                        Click="ImportSetup_Click"/>
                <Button Content="Export to ID" Margin="8,0,0,0"
                        Style="{StaticResource SmallButton}"
                        AutomationProperties.AutomationId="ExportToIdButton"
                        ToolTip="Put this setup into a cell of the ID table"
                        Click="ExportToId_Click"/>
                <Button Content="Export to E.G.O." Margin="8,0,0,0"
                        Style="{StaticResource SmallButton}"
                        AutomationProperties.AutomationId="ExportToEgoButton"
                        ToolTip="Put this setup into a cell of the E.G.O. table"
                        Click="ExportToEgo_Click"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Total damage" FontSize="15" Foreground="{DynamicResource SubtleTextBrush}"
                           VerticalAlignment="Center"/>
                <!-- Damage before the moratorium, in red; it is the total when the moratorium is off. -->
                <TextBlock FontSize="24" FontWeight="Bold" Margin="14,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource AccentBrush}"
                           Text="{Binding TotalLeading, Converter={StaticResource Num}, ConverterParameter=0.##, Mode=OneWay}"/>

                <!-- The rest of the equation appears only with the moratorium on. -->
                <TextBlock FontSize="24" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"
                           Text="&#215;"
                           Foreground="{DynamicResource TextBrush}"
                           Visibility="{Binding ShowMoratoriumEquation, Converter={StaticResource BoolToVisibility}}"/>
                <TextBlock FontSize="24" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource MoratoriumTextBrush}"
                           Visibility="{Binding ShowMoratoriumEquation, Converter={StaticResource BoolToVisibility}}"
                           Text="{Binding MoratoriumBuff, Converter={StaticResource Num}, ConverterParameter=0.##, Mode=OneWay}"/>
                <TextBlock FontSize="24" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"
                           Text="="
                           Foreground="{DynamicResource TextBrush}"
                           Visibility="{Binding ShowMoratoriumEquation, Converter={StaticResource BoolToVisibility}}"/>
                <TextBlock FontSize="24" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource MoratoriumTextBrush}"
                           Visibility="{Binding ShowMoratoriumEquation, Converter={StaticResource BoolToVisibility}}"
                           Text="{Binding Total, Converter={StaticResource Num}, ConverterParameter=0.##, Mode=OneWay}"/>

                <!-- Damage split by target; with a single target there's nothing to split. -->
                <Button Width="30" Height="30" Padding="0" Margin="18,0,0,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource IconTileButton}"
                        AutomationProperties.AutomationId="DamageByTargetButton"
                        IsEnabled="{Binding HasMultipleTargets}"
                        ToolTip="Damage by target"
                        Click="DamageByTarget_Click">
                    <Image Source="Assets/Icons/targetAim.png" Width="20" Height="20"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Button>
            </StackPanel>
          </DockPanel>
        </Border>
        </Grid>
        </TabItem>

        </TabControl>

        <!-- Which columns to show. The name can't be hidden, so it isn't listed. -->
        <Popup x:Name="ColumnsPopup" StaysOpen="False" AllowsTransparency="True"
               Placement="Bottom" VerticalOffset="4">
            <Border Style="{StaticResource Card}" Width="240" Margin="6">
                <StackPanel>
                    <TextBlock Text="Columns" Style="{StaticResource CardTitleText}"/>
                    <TextBlock Text="Hidden columns keep their data."
                               Foreground="{DynamicResource SubtleTextBrush}"
                               FontSize="12" Margin="0,0,0,8"/>
                    <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ColumnChoices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <CheckBox VerticalAlignment="Center"
                                                  AutomationProperties.AutomationId="{Binding Title}"
                                                  IsChecked="{Binding IsShown, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Text="{Binding Title}" Margin="8,0,0,0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Show all"
                                Style="{StaticResource SmallButton}"
                                AutomationProperties.AutomationId="ShowAllColumnsButton"
                                Click="ShowAllColumns_Click"/>
                        <Button Content="Hide all" Margin="8,0,0,0"
                                Style="{StaticResource SmallButton}"
                                AutomationProperties.AutomationId="HideAllColumnsButton"
                                ToolTip="Hide every column except the name"
                                Click="HideAllColumns_Click"/>
                    </StackPanel>

                    <!-- Order and widths are changed right in the header; this puts them back. -->
                    <TextBlock Text="Drag a header to move a column, drag its right edge to resize it."
                               Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="Wrap"
                               FontSize="12" Margin="0,12,0,6"/>
                    <Button Content="Reset order and widths" HorizontalAlignment="Left"
                            Style="{StaticResource SmallButton}"
                            AutomationProperties.AutomationId="ResetLayoutButton"
                            IsEnabled="{Binding HasCustomLayout}"
                            Click="ResetLayout_Click"/>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Value ranges: a minimum and a maximum per numeric column; empty means no limit. -->
        <Popup x:Name="RangePopup" StaysOpen="False" AllowsTransparency="True"
               Placement="Bottom" VerticalOffset="4">
            <Border Style="{StaticResource Card}" Width="300" Margin="6">
                <StackPanel>
                    <TextBlock Text="Value range" Style="{StaticResource CardTitleText}"/>
                    <TextBlock Text="Rows whose value is outside the range, or empty, are hidden. Leave a field empty for no limit."
                               Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="Wrap"
                               FontSize="12" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="Min" Margin="4,0" FontSize="12"
                                   Foreground="{DynamicResource SubtleTextBrush}"/>
                        <TextBlock Grid.Column="2" Text="Max" Margin="4,0" FontSize="12"
                                   Foreground="{DynamicResource SubtleTextBrush}"/>
                    </Grid>
                    <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Ranges}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="70"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Key}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Margin="4,0"
                                                 AutomationProperties.AutomationId="{Binding Key, StringFormat='{}{0} min'}"
                                                 Text="{Binding Min, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBox Grid.Column="2" Margin="4,0"
                                                 AutomationProperties.AutomationId="{Binding Key, StringFormat='{}{0} max'}"
                                                 Text="{Binding Max, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Popup>

        <!-- One filter list: type, sin or sinners — whichever was opened. -->
        <Popup x:Name="FilterPopup" StaysOpen="False" AllowsTransparency="True"
               Placement="Bottom" VerticalOffset="4">
            <Border Style="{StaticResource Card}" Width="220" Margin="6">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitleText}"/>
                    <TextBlock Text="Nothing checked means any."
                               Foreground="{DynamicResource SubtleTextBrush}"
                               FontSize="12" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <CheckBox VerticalAlignment="Center"
                                              IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Image Source="{Binding IconPath}" Width="16" Height="16"
                                           Margin="8,0,0,0" VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock Text="{Binding Name}" Margin="6,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Skill sort priority: opened by right-clicking a column header. -->
        <Popup x:Name="SortPriorityPopup" StaysOpen="False" AllowsTransparency="True"
               Placement="Bottom" VerticalOffset="4">
            <Border Style="{StaticResource Card}" Width="250" Margin="6">
                <StackPanel>
                    <TextBlock Text="Sort priority" Style="{StaticResource CardTitleText}"/>
                    <TextBlock Text="Top rule is compared first."
                               Foreground="{DynamicResource SubtleTextBrush}"
                               FontSize="12" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding SortPriority}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                               Width="130"/>
                                    <Button Content="▲" Style="{StaticResource SmallButton}"
                                            Click="PriorityUp_Click"/>
                                    <Button Content="▼" Style="{StaticResource SmallButton}"
                                            Margin="6,0,0,0" Click="PriorityDown_Click"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>



