<Window x:Class="LimbusCalc.SubtargetsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:behaviors="clr-namespace:LimbusCalc.Behaviors"
        xmlns:vm="clr-namespace:LimbusCalc.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:CoinViewModel}"
        Title="Subtargets resistances"
        Icon="Assets/Icons/lodgedArrow.png"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FontSize="13"
        FontFamily="{StaticResource AppFontFamily}"
        Background="{DynamicResource AppBackgroundBrush}">

    <Border Style="{StaticResource Card}" Margin="14">
        <StackPanel>
            <TextBlock Text="{Binding Number, StringFormat='Subtargets resistances — coin {0}'}"
                       Style="{StaticResource CardTitleText}"/>

            <!-- Шапка с иконками: подписи столбцов общие для всех подцелей. -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <Border Width="104"/>
                <ItemsControl ItemsSource="{Binding ResistanceHeaders}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="52">
                                <Image Source="{Binding IconPath}" Width="24" Height="24"
                                       ToolTip="{Binding Name}"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Ширина отступа та же, что у кнопок Reset в строках, — столбец сходится. -->
                <Button Content="Reset ALL" Style="{StaticResource SmallButton}"
                        Margin="10,0,0,0" VerticalAlignment="Center"
                        ToolTip="Copy the main target resistances and parameters into every subtarget"
                        Click="ResetAll_Click"/>
            </StackPanel>

            <!-- Целей бывает много: список прокручивается, а шапка с иконками
                 остаётся на месте. Колонки фиксированной ширины и прижаты влево,
                 поэтому появление полосы прокрутки их не сдвигает. -->
            <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Subtargets}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <Border Width="104" Padding="0,0,6,0">
                                <TextBox VerticalAlignment="Center" MinHeight="26" Padding="6,3"
                                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                            </Border>
                            <ItemsControl ItemsSource="{Binding Resistances}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="52" Padding="3,0">
                                            <TextBox TextAlignment="Center" MinHeight="28"
                                                     behaviors:NumericBox.Value="{Binding Value}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Reset" Style="{StaticResource SmallButton}"
                                    Margin="10,0,0,0" VerticalAlignment="Center"
                                    ToolTip="Copy the main target resistances and parameters here"
                                    Click="Reset_Click"/>
                            <Button Width="28" Height="28" Padding="0"
                                    Margin="8,0,0,0" VerticalAlignment="Center"
                                    Style="{StaticResource IconTileButton}"
                                    AutomationProperties.AutomationId="SubtargetParametersButton"
                                    ToolTip="Parameters of this subtarget"
                                    Click="Parameters_Click">
                                <Image Source="Assets/Icons/resistances.png"
                                       Width="18" Height="18"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Button>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>
        </StackPanel>
    </Border>
</Window>
